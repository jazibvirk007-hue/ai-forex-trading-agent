APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./trading.db

# Live-first execution. Both arm flags must be true before a real order can leave TJ Trading OS.
BROKER_MODE=live
BROKER_NAME=mt5
ALLOW_LIVE_TRADING=false
LIVE_TRADING_ARMED=false

# Optional when the local MT5 terminal is already logged in.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_DEVIATION=15
MT5_MAGIC=560001

# Micro-capital defaults.
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=1
MAX_CORRELATED_POSITIONS=1

FISH_AUDIO_MODEL=s2.1-pro
