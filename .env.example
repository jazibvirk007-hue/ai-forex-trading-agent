APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./trading.db

BROKER_MODE=live
BROKER_NAME=mt5
ALLOW_LIVE_TRADING=false
LIVE_TRADING_ARMED=false
AUTONOMOUS_EXECUTION_ENABLED=false

MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_DEVIATION=15
MT5_MAGIC=560001

RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=1
MAX_CORRELATED_POSITIONS=1
CORRELATION_THRESHOLD=0.80

ENGINE_AUTO_START=false
ENGINE_CYCLE_SECONDS=30
ENGINE_SYMBOLS=EURUSD,GBPUSD,USDJPY
ENGINE_TIMEFRAME=M5
ENGINE_BARS=220
MIN_AI_CONFIDENCE=0.66
REQUIRE_AI_CONSENSUS=true
MIN_SECONDS_BETWEEN_TRADES=900
DEAL_SYNC_HOURS=72
REFLECTION_ENABLED=true

# Optional startup AI configuration. You can instead configure it in memory from the UI.
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# Comma-separated RSS/Atom URLs used by the research agent.
RESEARCH_FEED_URLS=

FISH_AUDIO_MODEL=s2.1-pro
